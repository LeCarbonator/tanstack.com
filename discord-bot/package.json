{
  "name": "tanstack-discord-bot",
  "version": "1.0.0",
  "description": "A Discord Bot for searching TanStack documentation",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "pnpm clean && tsc",
    "clean": "rimraf dist",
    "start": "node dist/index.js",
    "dev": "pnpm build && pnpm start",
    "deploy:commands": "pnpm build && node dist/deployCommands.js",
    "typecheck": "tsc --noEmit",
    "test": "pnpm typecheck && vitest --config vitest.config.ts"
  },
  "keywords": [],
  "author": "Luca Jakob",
  "license": "MIT",
  "packageManager": "pnpm@10.26.0",
  "dependencies": {
    "algoliasearch": "^5.46.2",
    "discord.js": "^14.25.1",
    "dotenv": "^17.2.3",
    "instantsearch.js": "4.7.0",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "rimraf": "^6.1.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  }
}